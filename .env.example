# Google Gemini API Key（可选，旧混色建议用）
API_KEY=your_gemini_api_key_here

# ==========================================
# 官方 AI 涂装与精修通道 (Cloudflare Pages 环境变量)
# ==========================================
# 1. 火山方舟 API Key（必填，获取地址：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey）
ARK_API_KEY=your_volcengine_ark_api_key_here

# 2. 火山方舟 Seedream 模型 ID 或推理接入点 ep-xxxx（选填，默认 doubao-seedream-5-0-pro-260628）
ARK_SEEDREAM_MODEL=doubao-seedream-5-0-pro-260628

# 3. 充值卡密 HMAC 签名密钥（必填，任意长随机字符串，需与 npm run gen:cdk 生成卡密时一致）
CREDITS_SIGNING_SECRET=replace_with_a_long_random_secret_string

# 4. 前端充值购买跳转链接（选填：国内面包多/爱发电自动发卡链接 & 海外 Stripe/Creem 链接）
VITE_RECHARGE_URL_CN=
VITE_RECHARGE_URL_GLOBAL=

# 环境标识（开发/生产）
ENVIRONMENT=development
VITE_API_BASE_URL=http://localhost:5173

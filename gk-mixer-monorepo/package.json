{
  "name": "gk-mixer-monorepo",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@gk-mixer/web",
    "dev:mobile": "turbo run dev --filter=@gk-mixer/mobile",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "~5.8.2"
  }
}

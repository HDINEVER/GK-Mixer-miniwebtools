{
  "name": "@gk-mixer/core",
  "version": "0.1.0",
  "description": "GK Mixer pure logic brain - types, color math, state flow, API client. Zero UI, zero env-specific APIs.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": ["dist"],
  "dependencies": {
    "simple-color-converter": "^2.1.13"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "node test/ral.cjs && node test/mixbox.cjs && node test/paint-db.cjs && node test/color-extract.cjs && node test/parity.cjs",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo test/.tmp-parity"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "tsup": "^8.5.0",
    "typescript": "~5.8.2"
  }
}
